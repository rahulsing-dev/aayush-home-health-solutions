---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Media from '../components/ui/Media.astro';
import Icon from '../components/ui/Icon.astro';
import FaqList from '../components/sections/FaqList.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { career, applyMessage } from '../content/pages';
import { careerFaqs } from '../content/faqs';
import { contact, telHref, whatsappHref } from '../config/site';

const openings = career.openings;
const featured = openings[0];
const hiring = openings.length > 0;
const phone = contact.phones[0];
const mailto = (subject: string) => `mailto:${contact.email}?subject=${encodeURIComponent(subject)}`;
const roleNames = openings.map((o) => o.title).join(', ');
const numberWords = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six'];
const stepCount = numberWords[career.applySteps.length] ?? String(career.applySteps.length);
const description = hiring
  ? `Aayush Home Health Solutions is hiring: ${roleNames} in Bangalore. Best-in-class training, competitive remuneration, and the option to study Nursing while working.`
  : 'Join the Aayush Home Health Solutions team. Best-in-class training, competitive remuneration and a professional service environment.';
---
<BaseLayout title={hiring ? `Careers: ${roleNames} Jobs in Bangalore` : 'Career'} {description}>
  <!-- Hero -->
  <section class="c-hero">
    <div class="container c-hero__grid">
      <div class="c-hero__copy">
        <nav aria-label="Breadcrumb" class="crumbs">
          <ol>
            <li><a href="/">Home</a></li>
            <li><span aria-current="page">Career</span></li>
          </ol>
        </nav>
        {hiring
          ? <p class="hiring-pill"><span class="live-dot" aria-hidden="true"></span> Now hiring in {featured.location}</p>
          : <p class="eyebrow">Join our team</p>}
        <h1>Build a career in <span class="c-hero__accent">caring</span></h1>
        <p class="lead">{career.intro}</p>
        <div class="btn-row">
          {hiring
            ? <a class="btn btn--primary" href={`#role-${featured.id}`}>View the {featured.title} role <Icon name="arrow-right" size={18} /></a>
            : <a class="btn btn--primary" href={mailto('Career enquiry')}><Icon name="mail" size={18} /> Email your introduction</a>}
          <a class="btn btn--whatsapp" href={whatsappHref(applyMessage(featured?.title))} target="_blank" rel="noopener noreferrer" data-contact="whatsapp"><Icon name="whatsapp" size={18} /> {hiring ? 'Apply on WhatsApp' : 'Chat on WhatsApp'}<span class="sr-only"> (opens WhatsApp)</span></a>
        </div>
        <ul role="list" class="c-hero__points">
          {career.benefits.slice(0, 3).map((b) => <li><Icon name="check" size={16} /> {b.title}</li>)}
        </ul>
      </div>

      <div class="c-hero__visual">
        <Media image={career.image} eager sizes="(min-width: 960px) 540px, 100vw" />
        {hiring && (
          <div class="float-card float-card--role" aria-hidden="true">
            <span class="float-card__icon"><Icon name="users" size={22} /></span>
            <span class="float-card__text"><span>Now hiring</span><strong>{featured.title}s</strong></span>
          </div>
        )}
        {featured?.studyWhileWorking && (
          <div class="float-card float-card--study" aria-hidden="true">
            <span class="float-card__icon float-card__icon--teal"><Icon name="graduation-cap" size={22} /></span>
            <span class="float-card__text"><span>Earn while you learn</span><strong>Study Nursing while working</strong></span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Openings -->
  <section class="section section--soft" id="openings" aria-labelledby="open-h">
    <div class="container">
      <SectionHead
        center
        id="open-h"
        eyebrow={openings.length === 1 ? 'Current opening' : 'Current openings'}
        title={!hiring ? 'Current openings' : openings.length === 1 ? 'The role we are hiring for' : 'Roles we are hiring for'}
        text={hiring ? 'No complicated forms. Read the requirements, then apply by WhatsApp, phone or email.' : undefined}
      />
      {hiring ? (
        <div class="roles">
          {openings.map((o) => (
            <article class="role reveal" id={`role-${o.id}`} aria-labelledby={`role-${o.id}-h`}>
              <div class="role__main">
                <header class="role__head">
                  <span class="role__icon"><Icon name="users" size={28} /></span>
                  <div class="role__title">
                    <p class="role__status"><span class="live-dot" aria-hidden="true"></span> Actively hiring</p>
                    <h3 id={`role-${o.id}-h`}>{o.title}</h3>
                    <p class="role__meta"><Icon name="map-pin" size={16} /> {o.location}</p>
                  </div>
                </header>
                <p class="role__summary">{o.summary}</p>
                <h4 class="role__sub">Requirements</h4>
                <dl class="reqs">
                  {o.requirements.map((r) => (
                    <div class="req">
                      <dt><span class="req__icon"><Icon name={r.icon} size={20} /></span>{r.label}</dt>
                      <dd><strong>{r.value}</strong>{r.note && <span class="req__note">{r.note}</span>}</dd>
                    </div>
                  ))}
                </dl>
              </div>

              <div class="role__side">
                {o.studyWhileWorking && (
                  <div class="study">
                    <span class="study__icon"><Icon name="book-open" size={24} /></span>
                    <p class="study__label">Earn while you learn</p>
                    <p class="study__text">{o.studyWhileWorking}</p>
                  </div>
                )}
                <div class="apply">
                  <p class="apply__title">Apply for this role</p>
                  <a class="btn btn--whatsapp" href={whatsappHref(applyMessage(o.title))} target="_blank" rel="noopener noreferrer" data-contact="whatsapp"><Icon name="whatsapp" size={18} /> Apply on WhatsApp<span class="sr-only"> (opens WhatsApp)</span></a>
                  <a class="btn btn--outline" href={telHref(phone.tel)}><Icon name="phone" size={18} /> Call {phone.display}</a>
                  <a class="btn btn--outline" href={mailto(`Application: ${o.title}`)}><Icon name="mail" size={18} /> Apply by email</a>
                  <p class="apply__note"><Icon name="clock" size={16} /> {contact.availability}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty">
          <Icon name="briefcase" size={32} />
          <h3>No openings are listed right now</h3>
          <p>Specific roles will appear here when they are posted. If you would like to be considered for future openings, send us a short introduction and your contact details.</p>
          <a class="btn btn--primary" href={mailto('Career enquiry')}><Icon name="mail" size={18} /> Email your introduction</a>
          <p class="empty__addr">{contact.email}</p>
        </div>
      )}
    </div>
  </section>

  <!-- Benefits -->
  <section class="section" aria-labelledby="perks-h">
    <div class="container">
      <SectionHead center id="perks-h" eyebrow="Why work with us" title="Grow with a team that cares" text="We look after the people who look after our clients." />
      <ul role="list" class="perks">
        {career.benefits.map((b, i) => (
          <li class="perk reveal" style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <span class="perk__icon"><Icon name={b.icon} size={26} /></span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Is this role for you? -->
  {featured?.lookingFor && (
    <section class="section section--warm" aria-labelledby="fit-h">
      <div class="container fit">
        <div class="fit__media reveal">
          <Media image={career.fitImage} sizes="(min-width: 900px) 420px, 100vw" />
        </div>
        <div class="fit__copy reveal" style="--reveal-delay:100ms">
          <p class="eyebrow">Who we are looking for</p>
          <h2 id="fit-h">Is the {featured.title} role right for you?</h2>
          <p class="fit__intro">If most of these sound like you, we would love to hear from you.</p>
          <ul role="list" class="fit__list">
            {featured.lookingFor.map((item) => (
              <li><span class="fit__tick"><Icon name="check" size={16} /></span><span>{item}</span></li>
            ))}
          </ul>
          <a class="btn btn--whatsapp" href={whatsappHref(applyMessage(featured.title))} target="_blank" rel="noopener noreferrer" data-contact="whatsapp"><Icon name="whatsapp" size={18} /> Yes, I want to apply<span class="sr-only"> (opens WhatsApp)</span></a>
        </div>
      </div>
    </section>
  )}

  <!-- How to apply -->
  <section class="section" aria-labelledby="steps-h">
    <div class="container">
      <SectionHead center id="steps-h" eyebrow="How to apply" title={`${stepCount} simple steps`} />
      <ol role="list" class="steps">
        {career.applySteps.map((s, i) => (
          <li class="step reveal" style={`--reveal-delay:${i * 100}ms`}>
            <span class="step__num" aria-hidden="true">{i + 1}</span>
            <h3><span class="sr-only">Step {i + 1}: </span>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FAQs -->
  {hiring && (
    <section class="section section--soft" aria-labelledby="cfaq-h">
      <div class="container container--narrow">
        <SectionHead center id="cfaq-h" eyebrow="Questions" title="Common questions from applicants" />
        <FaqList items={careerFaqs} />
        <p class="more">More questions? <a href={telHref(phone.tel)}>Call {phone.display}</a> or <a href={mailto('Career enquiry')}>email us</a>.</p>
      </div>
    </section>
  )}

  <CtaBand
    title="Ready to start your career in care?"
    text={hiring ? `Apply for the ${featured.title} role today. We are reachable 24/7.` : 'Send us a short introduction. We are reachable 24/7.'}
    primary={{ label: hiring ? 'Apply by email' : 'Email your introduction', href: mailto(hiring ? `Application: ${featured.title}` : 'Career enquiry') }}
    whatsapp={{ label: hiring ? 'Apply on WhatsApp' : 'WhatsApp', message: applyMessage(featured?.title) }}
  />
</BaseLayout>

<style>
  /* Hero */
  .c-hero { position: relative; overflow: hidden; padding-block: clamp(2rem, 1.5rem + 3vw, 4.5rem) clamp(3rem, 2rem + 4vw, 5.5rem); background: radial-gradient(50rem 22rem at 90% -10%, var(--c-primary-tint), transparent 70%), radial-gradient(30rem 18rem at -10% 110%, var(--c-secondary-soft), transparent 70%), linear-gradient(180deg, var(--c-primary-soft), #fff); border-bottom: 1px solid var(--c-line); }
  .c-hero__grid { display: grid; gap: 2.75rem; align-items: center; }
  .c-hero__copy { display: grid; gap: 1.15rem; justify-items: start; }
  .c-hero h1 { max-width: 15ch; }
  .c-hero__accent { color: var(--c-primary); font-style: italic; }
  .c-hero .lead { max-width: 38rem; }
  .c-hero__points { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin-top: 0.25rem; font-size: 0.9375rem; font-weight: 600; color: var(--c-ink); }
  .c-hero__points li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .c-hero__points :global(svg) { color: var(--c-secondary); }

  .c-hero__visual { position: relative; padding: 0 0.5rem 2.25rem; }
  .c-hero__visual :global(.media) { box-shadow: var(--shadow-lg); }
  .float-card { position: absolute; display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 1rem 0.7rem 0.7rem; background: #fff; border-radius: var(--radius-md); box-shadow: var(--shadow-lg); max-width: calc(100% - 1rem); }
  .float-card--role { left: 0; bottom: 0; }
  .float-card--study { display: none; right: 0; top: 1.25rem; }
  .float-card__icon { flex: none; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--c-primary-soft); color: var(--c-primary); }
  .float-card__icon--teal { background: var(--c-secondary-soft); color: var(--c-secondary); }
  .float-card__text { display: grid; line-height: 1.3; }
  .float-card__text span { font-size: 0.8125rem; color: var(--c-muted); font-weight: 600; }
  .float-card__text strong { color: var(--c-ink); font-size: 1rem; }
  @media (min-width: 600px) { .float-card--study { display: flex; right: 0; } .c-hero__visual { padding: 0 0 2.25rem 1.5rem; } }
  @media (min-width: 960px) {
    .c-hero__grid { grid-template-columns: 1.05fr 0.95fr; gap: 4rem; }
    .c-hero__visual { padding: 0 0 2.5rem 2rem; }
    .float-card--role { left: 0; bottom: 0; }
    .float-card--study { right: -1rem; top: 2rem; }
  }

  /* Openings */
  .roles { display: grid; gap: 1.75rem; }
  .role { display: grid; background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; scroll-margin-top: calc(var(--header-h) + 1rem); }
  .role__main { display: grid; gap: 1.25rem; align-content: start; padding: clamp(1.35rem, 1rem + 1.5vw, 2.25rem); border-top: 4px solid var(--c-primary); }
  .role__head { display: flex; gap: 1rem; align-items: center; }
  .role__icon { flex: none; display: grid; place-items: center; width: 3.75rem; height: 3.75rem; border-radius: var(--radius-md); background: var(--c-primary-soft); color: var(--c-primary); }
  .role__title { display: grid; gap: 0.15rem; }
  .role__title h3 { font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem); }
  .role__status { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--c-success); }
  .role__meta { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--c-muted); font-weight: 600; }
  .role__summary { font-size: var(--fs-500); max-width: 40rem; }
  .role__sub { margin-top: 0.25rem; }
  .reqs { display: grid; gap: 0.85rem; margin: 0; }
  .req { display: grid; gap: 0.35rem; padding: 1rem 1.1rem; background: var(--c-bg-soft); border-radius: var(--radius-md); border: 1px solid transparent; transition: border-color var(--dur) var(--ease); }
  .req:hover { border-color: var(--c-primary-tint); }
  .req dt { display: flex; align-items: center; gap: 0.6rem; font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-muted); }
  .req__icon { flex: none; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: #fff; color: var(--c-primary); box-shadow: var(--shadow-sm); }
  .req dd { display: grid; gap: 0.15rem; margin: 0; padding-left: 2.85rem; }
  .req dd strong { color: var(--c-ink); font-size: 1.0625rem; font-weight: 650; line-height: 1.4; }
  .req__note { font-size: 0.9375rem; color: var(--c-secondary); font-weight: 600; }
  @media (min-width: 640px) { .reqs { grid-template-columns: repeat(2, 1fr); } }

  .role__side { display: grid; gap: 1.25rem; align-content: start; padding: clamp(1.35rem, 1rem + 1.5vw, 2rem); background: linear-gradient(180deg, var(--c-primary-soft), #fff 70%); border-top: 1px solid var(--c-line); }
  .study { display: grid; gap: 0.4rem; padding: 1.25rem; border-radius: var(--radius-md); color: #fff; background: linear-gradient(135deg, var(--c-secondary), #0b6463); box-shadow: var(--shadow-md); }
  .study__icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: rgb(255 255 255 / 0.16); margin-bottom: 0.25rem; }
  .study__label { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #d5f1ef; }
  .study__text { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.35; font-weight: 600; }
  .apply { display: grid; gap: 0.75rem; }
  .apply__title { font-weight: 700; color: var(--c-ink); font-size: 1.0625rem; }
  .apply__note { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: var(--c-muted); }
  @media (min-width: 960px) {
    .role { grid-template-columns: 1fr 22rem; }
    .role__side { border-top: 4px solid var(--c-secondary); border-left: 1px solid var(--c-line); }
  }

  .empty { display: grid; gap: 0.85rem; justify-items: center; text-align: center; max-width: var(--container-narrow); margin-inline: auto; padding: 2.5rem 1.5rem; background: #fff; border: 1.5px dashed #b9c8d5; border-radius: var(--radius-lg); }
  .empty :global(svg) { color: var(--c-primary); }
  .empty p { color: var(--c-muted); max-width: 34rem; }
  .empty .empty__addr { margin-top: -0.35rem; font-size: 0.875rem; overflow-wrap: anywhere; }

  /* Benefits */
  .perks { display: grid; gap: 1.25rem; }
  @media (min-width: 640px) { .perks { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .perks { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; } }
  .perk { position: relative; display: grid; gap: 0.7rem; align-content: start; padding: 1.75rem 1.5rem; border: 1px solid var(--c-line); border-radius: var(--radius-lg); background: #fff; box-shadow: var(--shadow-sm); transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  .perk:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: var(--c-primary-tint); }
  .perk__icon { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: var(--radius-md); background: var(--c-primary-soft); color: var(--c-primary); }
  .perk:nth-child(2) .perk__icon { background: var(--c-secondary-soft); color: var(--c-secondary); }
  .perk h3 { font-size: 1.25rem; }
  .perk p { color: var(--c-muted); }

  /* Fit */
  .fit { display: grid; gap: 2.25rem; align-items: center; }
  .fit__media { max-width: 26rem; }
  .fit__media :global(.media) { box-shadow: var(--shadow-lg); }
  .fit__copy { display: grid; gap: 1rem; justify-items: start; }
  .fit__intro { color: var(--c-muted); font-size: var(--fs-500); }
  .fit__list { display: grid; gap: 0.7rem; margin-block: 0.25rem 0.5rem; }
  .fit__list li { display: flex; gap: 0.8rem; align-items: flex-start; padding: 0.85rem 1rem; background: #fff; border-radius: var(--radius-md); box-shadow: var(--shadow-sm); color: var(--c-ink); font-weight: 550; }
  .fit__tick { flex: none; display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--c-secondary); color: #fff; margin-top: 0.05rem; }
  @media (min-width: 900px) { .fit { grid-template-columns: 0.8fr 1.2fr; gap: 4.5rem; } .fit__media { max-width: none; } }

  /* Steps */
  .steps { display: grid; gap: 1.25rem; }
  .step { position: relative; display: grid; gap: 0.6rem; align-content: start; padding: 1.75rem 1.5rem 1.5rem; border-radius: var(--radius-lg); background: var(--c-bg-soft); }
  .step__num { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: var(--c-primary); color: #fff; font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; box-shadow: 0 0 0 6px var(--c-primary-soft); margin-bottom: 0.4rem; }
  .step p { color: var(--c-muted); }
  @media (min-width: 860px) {
    .steps { grid-template-columns: repeat(3, 1fr); gap: 1.75rem; }
    .step:not(:last-child)::after { content: ''; position: absolute; top: 3.25rem; left: calc(1.5rem + 3.5rem); right: -1.75rem; height: 2px; background: repeating-linear-gradient(90deg, var(--c-primary-tint) 0 8px, transparent 8px 14px); }
  }

  .more { margin-top: 1.75rem; text-align: center; color: var(--c-muted); }
</style>
