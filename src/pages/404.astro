---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { contact, telHref } from '../config/site';
---
<BaseLayout title="Page not found" noindex description="The page you are looking for could not be found.">
  <section class="section nf">
    <div class="container container--narrow nf__inner">
      <p class="nf__code" aria-hidden="true">404</p>
      <h1>We couldn't find that page</h1>
      <p class="lead">The page may have moved or the link may be incorrect. You can head back home, explore our services, or contact us directly.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Back to home</a>
        <a class="btn btn--outline" href="/services">Our services</a>
        <a class="btn btn--outline" href={telHref(contact.phones[0].tel)}><Icon name="phone" size={18} /> {contact.phones[0].display}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { background: var(--c-bg-soft); min-height: 60vh; display: grid; align-items: center; }
  .nf__inner { display: grid; gap: 1.25rem; justify-items: center; text-align: center; }
  .nf__code { font-family: var(--font-display); font-size: clamp(4.5rem, 3rem + 8vw, 8rem); font-weight: 700; line-height: 1; color: #6a86a0; }
  .nf .btn-row { justify-content: center; }
</style>
