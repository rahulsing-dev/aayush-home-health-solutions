---
import { getPublishedPosts } from '../content/blog';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { services } from '../content/services';
import { footerLegal, mainNav } from '../config/navigation';

const posts = await getPublishedPosts();
// Built from the same navigation as the header and footer; Services and Blog get their own columns.
const pages = mainNav.filter((n) => !n.children && n.href !== '/blog').map(({ label, href }) => ({ label, href }));
const groups = [
  { title: 'Main', links: [{ label: 'Home', href: '/' }, ...pages, { label: 'Contact Us', href: '/contact' }] },
  { title: 'Services', links: [{ label: 'All services', href: '/services' }, ...services.map((s) => ({ label: s.title, href: `/services/${s.slug}` }))] },
  { title: 'Blog', links: [{ label: 'All articles', href: '/blog' }, ...posts.map((p) => ({ label: p.data.title, href: `/blog/${p.id}` }))] },
  { title: 'Legal', links: footerLegal.filter((l) => l.href !== '/site-map') },
];
---
<BaseLayout title="Site Map" description="A list of every page on the Aayush Home Health Solutions website.">
  <PageHeader title="Site Map" crumbs={[{ label: 'Site Map' }]} />
  <section class="section">
    <div class="container map">
      {groups.map((g) => (
        <div>
          <h2>{g.title}</h2>
          <ul role="list">{g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .map { display: grid; gap: 2.5rem 2rem; }
  @media (min-width: 640px) { .map { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .map { grid-template-columns: repeat(4, 1fr); } }
  h2 { font-size: 1.375rem; margin-bottom: 1rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; }
  /* 44 px tall rows: comfortable tap targets, and the same rhythm as the 0.6rem-spaced list before. */
  li a { display: inline-flex; align-items: center; min-height: 2.75rem; padding-block: 0.35rem; line-height: 1.4; }
</style>
