---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { addressOneLine, contact, offices, site } from '../config/site';
---
<BaseLayout title="Privacy Policy" description={`How ${site.name} handles personal information shared through this website.`}>
  <PageHeader title="Privacy Policy" eyebrow="Legal" crumbs={[{ label: 'Privacy Policy' }]} />
  <section class="section">
    <div class="container container--narrow">
      <div class="prose">
        <p>This policy explains how {site.name} (“we”, “us”) handles personal information that you share with us through this website.</p>

        <h2>Information we collect</h2>
        <p>When you use the enquiry or booking form, we ask for your name, phone number, where care is needed (area or city) and the service you are interested in. A preferred start date is required for a booking and optional for an enquiry; an email address and a message are optional. If you contact us by phone, WhatsApp or email, we receive the details you choose to share.</p>
        <p>Please do not include detailed medical records or other sensitive health information in the website forms. We will discuss those details with you directly.</p>

        <h2>How we use it</h2>
        <p>We use this information to respond to your enquiry, discuss and arrange the service you ask about, and to keep reasonable records of our communication with you.</p>
        <p>Form submissions are delivered to our email inbox by Web3Forms, a form delivery service.</p>

        <h2>Cookies and analytics</h2>
        <p>This website does not set tracking cookies or load third-party analytics scripts. If that changes, we will update this policy first.</p>

        <h2>Your choices</h2>
        <p>You can ask us to access, correct or delete the personal information you have shared with us by writing to <a href={`mailto:${contact.email}`}>{contact.email}</a>.</p>

        <h2>Contact</h2>
        <p>{site.name}, {addressOneLine(offices[0])}.<br />Email: <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

