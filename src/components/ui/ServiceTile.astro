---
/**
 * One service as a card: tinted icon, title, summary. The whole card links to the service page;
 * the full variant adds an "Enquire" button that opens the form with the service pre-selected.
 * `compact` (home page) drops the button and, on small phones, the summary and "Learn more" label.
 * Colour comes from the service's group (`.tone-*` in global.css).
 */
import Icon from './Icon.astro';
import type { Service } from '../../lib/types';
import { enquireHref, getCategory } from '../../content/services';

interface Props { service: Service; compact?: boolean }
const { service: s, compact = false } = Astro.props;
const tone = getCategory(s.category)?.tone ?? 'blue';
---
<div class:list={['tile', `tone-${tone}`, compact && 'tile--compact']}>
  <span class="tile__icon"><Icon name={s.icon} size={compact ? 24 : 26} /></span>
  <h3 class="tile__title"><a href={`/services/${s.slug}`} class="tile__link">{s.title}</a></h3>
  <p class="tile__text">{s.summary}</p>
  <div class="tile__foot">
    <span class="tile__more" aria-hidden="true"><span class="tile__more-label">Learn more</span> <Icon name="arrow-right" size={18} /></span>
    {!compact && <a class="tile__enq" href={enquireHref(s.slug)}>Enquire<span class="sr-only"> about {s.title}</span></a>}
  </div>
</div>

<style>
  .tile { position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; align-items: flex-start; gap: 0.7rem; height: 100%; padding: 1.5rem 1.5rem 1.25rem; background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  /* A soft tinted disc grows from the corner on hover. */
  .tile::before { content: ''; position: absolute; z-index: -1; right: -4rem; bottom: -4rem; width: 9rem; height: 9rem; border-radius: 50%; background: var(--tone-soft); opacity: 0; transform: scale(0.6); transition: opacity 320ms var(--ease), transform 320ms var(--ease); }
  .tile:hover, .tile:focus-within { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: color-mix(in srgb, var(--tone) 35%, #fff); }
  .tile:hover::before, .tile:focus-within::before { opacity: 1; transform: scale(1.35); }
  .tile__icon { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: var(--radius-md); background: var(--tone-soft); color: var(--tone); transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease); }
  .tile:hover .tile__icon, .tile:focus-within .tile__icon { background: var(--tone); color: #fff; }
  .tile__title { font-size: 1.25rem; margin-top: 0.15rem; }
  .tile__link { color: var(--c-ink); text-decoration: none; }
  .tile__link::after { content: ''; position: absolute; inset: 0; z-index: 1; } /* whole card is the click target */
  .tile__link:focus-visible { outline: none; }
  .tile:has(.tile__link:focus-visible) { outline: 3px solid var(--c-primary); outline-offset: 3px; }
  .tile__text { color: var(--c-muted); }
  .tile__foot { margin-top: auto; width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding-top: 0.35rem; }
  .tile__more { display: inline-flex; align-items: center; gap: 0.35rem; font-weight: 650; color: var(--tone); }
  .tile__more :global(svg) { transition: transform var(--dur) var(--ease); }
  .tile:hover .tile__more :global(svg) { transform: translateX(4px); }
  .tile__enq { position: relative; z-index: 2; display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0.4rem 1.15rem; border: 1.5px solid var(--c-line); border-radius: 999px; background: #fff; color: var(--c-ink); font-weight: 650; text-decoration: none; transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease), color var(--dur) var(--ease); }
  .tile__enq:hover { border-color: var(--tone); background: var(--tone-soft); color: var(--tone); }

  .tile--compact { padding: 1.25rem; gap: 0.55rem; }
  .tile--compact .tile__title { font-size: 1.125rem; }
  .tile--compact .tile__text { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .tile--compact .tile__foot { padding-top: 0; }
  /* Two compact cards per row on small phones: icon + title only. */
  @media (max-width: 559px) {
    .tile--compact { padding: 1rem; }
    .tile--compact .tile__icon { width: 2.75rem; height: 2.75rem; }
    .tile--compact .tile__title { font-size: 1.0625rem; }
    .tile--compact .tile__text, .tile--compact .tile__more-label { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .tile:hover, .tile:focus-within { transform: none; } }
</style>
