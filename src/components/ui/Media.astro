---
/**
 * Renders an ImageSlot as a responsive, optimised <picture> (AVIF + WebP at several widths),
 * so phones download a small file and desktops a sharp one. Photos live in src/assets/images/
 * (site photography) or src/assets/gallery/ (the team's own photos) and are referenced from
 * content files by file name. Empty `src` -> a labelled placeholder
 * that holds the aspect ratio, so layouts stay balanced before real photography arrives.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ImageSlot } from '../../lib/types';
import Icon from './Icon.astro';

interface Props {
  image: ImageSlot;
  class?: string;
  /** Above-the-fold image: load immediately with high priority. */
  eager?: boolean;
  /** How wide the image is displayed at each breakpoint (the `sizes` attribute). Defaults to full width. */
  sizes?: string;
}
const { image, class: className, eager = false, sizes = '100vw' } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/{images,gallery}/*.{avif,webp,png,jpg,jpeg}', { eager: true });
const asset = image.src
  ? (files[`../../assets/images/${image.src}`] ?? files[`../../assets/gallery/${image.src}`])?.default
  : undefined;
if (image.src && !asset) {
  throw new Error(`Media: "${image.src}" was not found in src/assets/images/ or src/assets/gallery/. Check the file name in the content file.`);
}
// Never upscale: offer only widths up to the original's width, plus the original width itself
// when it falls between the steps (a 1024 px photo is offered at 480, 800 and 1024).
const widths = asset ? [480, 800, 1200, 1600].filter((w) => w <= asset.width) : [];
if (asset && asset.width < 1600 && !widths.includes(asset.width)) widths.push(asset.width);
---
<div class:list={['media', className]} style={`aspect-ratio: ${image.ratio};`}>
  {asset ? (
    <Picture
      src={asset}
      alt={image.alt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={widths}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : undefined}
      style={image.position ? `object-position: ${image.position};` : undefined}
    />
  ) : (
    <div class="media__ph" role="img" aria-label={`Image placeholder: ${image.alt}`}>
      <Icon name="image" size={30} />
      <span class="media__label">Image Placeholder</span>
      <span class="media__dims">{image.width} × {image.height} px · {image.ratio.replace(/\s/g, '')}</span>
    </div>
  )}
</div>

<style>
  .media { position: relative; overflow: hidden; border-radius: var(--radius-lg); background: var(--c-primary-soft); container-type: inline-size; }
  .media :global(picture) { display: contents; }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .media__ph {
    position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 0.35rem; padding: 1rem; text-align: center; color: #5d7387;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0)) ,
      repeating-linear-gradient(135deg, #e6eef5 0 14px, #dfe8f0 14px 28px);
  }
  .media__label { font-size: 0.8125rem; font-weight: 650; letter-spacing: 0.06em; text-transform: uppercase; }
  .media__dims { font-size: 0.75rem; opacity: 0.9; font-variant-numeric: tabular-nums; }
  @container (max-width: 200px) { .media__dims { display: none; } .media__label { font-size: 0.7rem; } }
</style>
