---
/**
 * A short, silent, looping clip that costs nothing on page load: `preload="none"` with a small
 * WebP poster. With JS, it plays only while on screen and has a play/pause button (WCAG 2.2.2);
 * it never autoplays for reduced-motion or data-saver users. Without JS, native controls are shown.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { VideoSlot } from '../../lib/types';
import Icon from './Icon.astro';

interface Props { video: VideoSlot; class?: string }
const { video, class: className } = Astro.props;

const clips = import.meta.glob<string>('../../assets/gallery/*.mp4', { eager: true, query: '?url', import: 'default' });
const stills = import.meta.glob<{ default: ImageMetadata }>('../../assets/gallery/*.{jpg,jpeg,png,webp}', { eager: true });
const src = clips[`../../assets/gallery/${video.src}`];
const still = stills[`../../assets/gallery/${video.poster}`]?.default;
if (!src) throw new Error(`VideoCard: "${video.src}" was not found in src/assets/gallery/.`);
if (!still) throw new Error(`VideoCard: poster "${video.poster}" was not found in src/assets/gallery/.`);
const poster = await getImage({ src: still, format: 'webp', width: Math.min(800, still.width), quality: 70 });
---
<div class:list={['video', className]} style={`aspect-ratio: ${video.ratio};`} data-video>
  <video muted loop playsinline controls preload="none" poster={poster.src} width={still.width} height={still.height} aria-label={video.label}>
    <source src={src} type="video/mp4" />
  </video>
  <button type="button" class="video__toggle" aria-label="Play video" hidden>
    <span class="video__icon video__icon--play"><Icon name="play" size={18} /></span>
    <span class="video__icon video__icon--pause"><Icon name="pause" size={18} /></span>
  </button>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  const autoplay = !reduce && !saveData;

  document.querySelectorAll<HTMLElement>('[data-video]').forEach((box) => {
    const video = box.querySelector('video');
    const btn = box.querySelector<HTMLButtonElement>('.video__toggle');
    if (!video || !btn) return;
    video.controls = false;
    btn.hidden = false;
    let userPaused = !autoplay;
    let onScreen = false;

    const sync = () => {
      const playing = !video.paused;
      box.classList.toggle('is-playing', playing);
      btn.setAttribute('aria-label', playing ? 'Pause video' : 'Play video');
    };
    const play = () => video.play().catch(() => { /* autoplay refused: stay on the poster */ });
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);

    btn.addEventListener('click', () => {
      if (video.paused) { userPaused = false; play(); } else { userPaused = true; video.pause(); }
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        onScreen = entry.isIntersecting;
        if (onScreen && !userPaused) play();
        else if (!onScreen && !video.paused) video.pause();
      }, { threshold: 0.4 }).observe(box);
    }
  });
</script>

<style>
  .video { position: relative; overflow: hidden; border-radius: var(--radius-lg); background: var(--c-navy); }
  .video video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .video__toggle {
    position: absolute; top: 0.75rem; right: 0.75rem; z-index: 2; display: grid; place-items: center; width: 2.75rem; height: 2.75rem;
    border: 0; border-radius: 50%; background: rgb(255 255 255 / 0.92); color: var(--c-ink); cursor: pointer; box-shadow: var(--shadow-md);
    transition: transform var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .video__toggle:hover { background: #fff; transform: scale(1.06); }
  .video__toggle:focus-visible { outline: 3px solid #fff; outline-offset: 2px; box-shadow: 0 0 0 6px var(--c-primary); }
  .video__icon { display: grid; }
  .video__icon--pause, .is-playing .video__icon--play { display: none; }
  .is-playing .video__icon--pause { display: grid; }
</style>
