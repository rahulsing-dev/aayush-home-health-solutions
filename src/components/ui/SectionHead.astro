---
interface Props { title: string; eyebrow?: string; text?: string; center?: boolean; id?: string }
const { title, eyebrow, text, center = false, id } = Astro.props;
---
<div class:list={['section-head', center && 'section-head--center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 {id}>{title}</h2>
  {text && <p>{text}</p>}
  <slot />
</div>
