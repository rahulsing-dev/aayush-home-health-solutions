---
/**
 * Accordion of questions, built on <details> so it works without JS and with the keyboard.
 * Each question has a stable id (`faqId`) so it can be linked to directly. Opening and closing
 * animate where the browser supports `::details-content` (others simply open instantly).
 */
import Icon from '../ui/Icon.astro';
import { faqs, faqId, type Faq } from '../../content/faqs';
/** `items` overrides the general FAQ list (e.g. the career questions). */
interface Props { items?: Faq[] }
const { items = faqs } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details class="faq__item" id={faqId(f.q)} data-faq>
      <summary>
        <span class="faq__q">{f.q}</span>
        <span class="faq__icon" aria-hidden="true"></span>
      </summary>
      <div class="faq__answer">
        <p>{f.a}</p>
        {f.points && <ul class="faq__points">{f.points.map((p) => <li><Icon name="check" size={18} /><span>{p}</span></li>)}</ul>}
        {f.links && (
          <p class="faq__links">
            {f.links.map((l) => <a class="link-arrow" href={l.href}>{l.label} <Icon name="arrow-right" size={16} /></a>)}
          </p>
        )}
      </div>
    </details>
  ))}
</div>

<style>
  .faq { display: grid; gap: 0.75rem; interpolate-size: allow-keywords; }
  .faq__item { background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-md); transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  .faq__item:hover { border-color: var(--c-primary-tint); }
  .faq__item[open] { border-color: var(--c-primary-tint); box-shadow: var(--shadow-md); }
  .faq__item::details-content { block-size: 0; overflow-y: clip; transition: block-size 300ms var(--ease), content-visibility 300ms allow-discrete; }
  .faq__item[open]::details-content { block-size: auto; }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 3.5rem; padding: 1rem 1.25rem; cursor: pointer; list-style: none; font-weight: 620; color: var(--c-ink); font-size: 1.0625rem; line-height: 1.4; border-radius: var(--radius-md); transition: color var(--dur) var(--ease); }
  summary::-webkit-details-marker { display: none; }
  summary:hover, .faq__item[open] summary { color: var(--c-primary-strong); }
  summary:focus-visible { outline-offset: -3px; }
  .faq__icon { position: relative; flex: none; width: 2rem; height: 2rem; border-radius: 50%; background: var(--c-primary-soft); transition: background-color var(--dur) var(--ease), transform 300ms var(--ease); }
  .faq__icon::before, .faq__icon::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.75rem; height: 2px; border-radius: 2px; background: var(--c-primary); transform: translate(-50%, -50%); transition: transform 300ms var(--ease), background-color var(--dur) var(--ease); }
  .faq__icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq__item[open] .faq__icon { background: var(--c-primary); transform: rotate(180deg); }
  .faq__item[open] .faq__icon::before, .faq__item[open] .faq__icon::after { background: #fff; }
  .faq__item[open] .faq__icon::after { transform: translate(-50%, -50%) rotate(0deg); }
  /* overflow-wrap: long unbroken text such as the email address must wrap on small phones. */
  .faq__answer { display: grid; gap: 0.85rem; padding: 0 1.25rem 1.35rem; color: var(--c-text); max-width: 46rem; overflow-wrap: anywhere; }
  .faq__points { display: grid; gap: 0.5rem; list-style: none; margin: 0; padding: 0; }
  .faq__points li { display: flex; gap: 0.6rem; align-items: flex-start; }
  .faq__points :global(svg) { flex: none; margin-top: 0.2rem; color: var(--c-secondary); }
  .faq__links { display: flex; flex-wrap: wrap; gap: 0 1.5rem; }
  .faq__links a { min-height: 2.75rem; font-size: 0.9375rem; }
</style>
