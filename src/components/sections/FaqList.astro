---
import DraftBadge from '../ui/DraftBadge.astro';
import { faqs } from '../../content/faqs';
interface Props { limit?: number }
const { limit } = Astro.props;
const items = limit ? faqs.filter((f) => f.verified).slice(0, limit) : faqs;
---
<div class="faq">
  {items.map((f) => (
    <details class="faq__item">
      <summary>
        <span>{f.q} {!f.verified && <DraftBadge />}</span>
        <span class="faq__icon" aria-hidden="true"></span>
      </summary>
      <div class="faq__answer"><p>{f.a}</p></div>
    </details>
  ))}
</div>

<style>
  .faq { display: grid; gap: 0.85rem; }
  .faq__item { background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-md); transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  .faq__item[open] { border-color: var(--c-primary-tint); box-shadow: var(--shadow-sm); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.15rem 1.35rem; cursor: pointer; list-style: none; font-weight: 620; color: var(--c-ink); font-size: 1.0625rem; line-height: 1.4; border-radius: var(--radius-md); }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--c-primary); }
  summary:focus-visible { outline-offset: -3px; }
  .faq__icon { position: relative; flex: none; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: var(--c-primary-soft); }
  .faq__icon::before, .faq__icon::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.75rem; height: 2px; background: var(--c-primary); transform: translate(-50%, -50%); transition: transform var(--dur) var(--ease); }
  .faq__icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq__item[open] .faq__icon::after { transform: translate(-50%, -50%) rotate(0deg); }
  .faq__answer { padding: 0 1.35rem 1.4rem; color: var(--c-text); max-width: 46rem; }
</style>
