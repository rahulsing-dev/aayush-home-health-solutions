---
import Icon from '../ui/Icon.astro';
import { contact, telHref } from '../../config/site';
interface Props { title: string; text?: string; primary?: { label: string; href: string }; showPhone?: boolean }
const { title, text, primary = { label: 'Make an Enquiry', href: '/contact' }, showPhone = true } = Astro.props;
const phone = contact.phones[0];
---
<section class="cta">
  <div class="container cta__inner">
    <div class="cta__copy">
      <h2>{title}</h2>
      {text && <p>{text}</p>}
    </div>
    <div class="btn-row">
      <a class="btn btn--light" href={primary.href}>{primary.label} <Icon name="arrow-right" size={18} /></a>
      {showPhone && <a class="btn btn--ghost-light" href={telHref(phone.tel)}><Icon name="phone" size={18} /> {phone.display}</a>}
    </div>
  </div>
</section>

<style>
  .cta { background: linear-gradient(120deg, var(--c-primary-strong), var(--c-primary) 60%, #1478c0); color: #e6f1fa; padding-block: clamp(2.75rem, 2rem + 3vw, 4.5rem); position: relative; overflow: hidden; }
  .cta::after { content: ''; position: absolute; right: -6rem; top: -8rem; width: 22rem; height: 22rem; border-radius: 50%; background: rgb(255 255 255 / 0.07); pointer-events: none; }
  .cta__inner { position: relative; z-index: 1; display: grid; gap: 1.75rem; align-items: center; }
  .cta h2 { color: #fff; font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.25rem); }
  .cta p { margin-top: 0.6rem; font-size: var(--fs-500); max-width: 38rem; }
  @media (min-width: 900px) { .cta__inner { grid-template-columns: 1fr auto; gap: 3rem; } }
</style>
