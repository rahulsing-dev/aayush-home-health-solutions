---
import Media from '../ui/Media.astro';
import Icon from '../ui/Icon.astro';
import { testimonialImage, testimonials } from '../../content/pages';
interface Props { limit?: number }
const { limit } = Astro.props;
const items = limit ? testimonials.slice(0, limit) : testimonials;
---
<div class="tst">
  <div class="tst__media reveal"><Media image={testimonialImage} /></div>
  <div class="tst__list">
    {items.map((t, i) => (
      <figure class="tst__card reveal" style={`--reveal-delay:${i * 100}ms`}>
        <Icon name="quote" size={30} class="tst__quote" />
        <blockquote><p>{t.quote}</p></blockquote>
        <figcaption><span class="tst__avatar" aria-hidden="true">{t.author.charAt(0)}</span> <span><strong>{t.author}</strong><span class="tst__role">Client family</span></span></figcaption>
      </figure>
    ))}
  </div>
</div>

<style>
  .tst { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 960px) { .tst { grid-template-columns: 0.8fr 1.2fr; gap: 3.5rem; } .tst__media { position: sticky; top: calc(var(--header-h) + 1.5rem); } }
  .tst__list { display: grid; gap: 1.5rem; }
  @media (max-width: 959px) { .tst__media :global(.media) { aspect-ratio: 16 / 10 !important; } }
  .tst__card { position: relative; display: grid; gap: 1.1rem; padding: 1.75rem 1.5rem; background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
  @media (min-width: 640px) { .tst__card { padding: 2rem 2.25rem; } }
  .tst__card :global(.tst__quote) { color: var(--c-primary-tint); }
  .tst blockquote { color: var(--c-text); font-size: 1.0625rem; line-height: 1.75; }
  .tst figcaption { display: flex; align-items: center; gap: 0.8rem; padding-top: 1rem; border-top: 1px solid var(--c-line); }
  .tst figcaption > span:last-child { display: grid; line-height: 1.3; }
  .tst__role { font-size: 0.8125rem; color: var(--c-muted); }
  .tst__avatar { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: var(--c-primary); color: #fff; font-weight: 700; font-family: var(--font-display); }
</style>
