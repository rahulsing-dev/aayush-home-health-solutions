---
/**
 * Home page hero: headline, short lead, enquiry + services CTAs and a 24/7 call line, beside one
 * large photo with two floating cards (the tagline, and the service count when there is more than
 * one service). Mobile first: copy, then the photo cropped to 4:3 with the subjects kept in frame.
 * Entrance motion is CSS only, runs once, and is skipped for reduced-motion users; the photo is
 * never faded (it is the LCP element), only unveiled with clip-path and a slight zoom.
 */
import Media from '../ui/Media.astro';
import Icon from '../ui/Icon.astro';
import { contact, site, telHref } from '../../config/site';
import { hero } from '../../content/pages';
import { featuredServices, getCategory, services } from '../../content/services';

const phone = contact.phones[0];
const [titleStart] = hero.title.split(hero.titleAccent);
const serviceIcons = (featuredServices.length ? featuredServices : services)
  .slice(0, 3)
  .map((s) => ({ icon: s.icon, tone: getCategory(s.category)?.tone ?? 'blue' }));
---
<section class="hero" aria-labelledby="hero-h">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow hero__in" style="--i:0">{hero.eyebrow}</p>
      <h1 id="hero-h" class="hero__in" style="--i:1">
        {titleStart}<span class="hero__accent">{hero.titleAccent}<svg class="hero__swoosh" viewBox="0 0 320 20" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M5 14 C 70 5, 190 2, 315 10" pathLength="1" /></svg></span>
      </h1>
      <p class="lead hero__lead hero__in" style="--i:2">{hero.lead}</p>
      <div class="btn-row hero__in" style="--i:3">
        <a class="btn btn--primary hero__cta" href="/contact">Make an Enquiry <Icon name="arrow-right" size={18} /></a>
        <a class="btn btn--outline" href="/services">Explore our services</a>
      </div>
      <p class="hero__call hero__in" style="--i:4">
        <span class="live-dot" aria-hidden="true"></span>
        <span>Reachable 24/7</span>
        <span class="hero__sep" aria-hidden="true"></span>
        <a href={telHref(phone.tel)} data-contact="call"><Icon name="phone" size={17} /> {phone.display}</a>
      </p>
    </div>

    <div class="hero__visual">
      <div class="hero__frame">
        <Media image={hero.image} eager sizes="(min-width: 1200px) 580px, (min-width: 960px) 48vw, (min-width: 600px) 40rem, 100vw" />
      </div>
      <p class="hero__chip"><Icon name="heart" size={16} /> {site.tagline}</p>
      {services.length > 1 && (
        <p class="hero__card">
          <span class="hero__stack" aria-hidden="true">
            {serviceIcons.map((s) => <span class={`tone-${s.tone}`}><Icon name={s.icon} size={17} /></span>)}
          </span>
          <span class="hero__card-text"><strong>{services.length} care services</strong><span>Ongoing or for a fixed period</span></span>
        </p>
      )}
    </div>
  </div>
</section>

<style>
  /* ---------- Canvas ---------- */
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    padding-block: clamp(2rem, 1.25rem + 3.5vw, 5rem) clamp(3.5rem, 2.75rem + 3.5vw, 6rem);
    background:
      radial-gradient(44rem 30rem at 100% 0%, var(--c-primary-tint), transparent 65%),
      radial-gradient(34rem 24rem at 0% 100%, var(--c-secondary-soft), transparent 70%),
      linear-gradient(180deg, var(--c-bg-soft), #fff);
  }
  /* A faint dot grid behind the photo adds texture without competing with it. */
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image: radial-gradient(rgb(11 95 165 / 0.13) 1.2px, transparent 1.6px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(30rem 24rem at 82% 55%, #000, transparent 72%);
    mask-image: radial-gradient(30rem 24rem at 82% 55%, #000, transparent 72%);
  }
  .hero__grid { display: grid; gap: clamp(2.25rem, 1.5rem + 3vw, 4rem); align-items: center; }

  /* ---------- Copy ---------- */
  .hero__copy { display: grid; gap: 1.1rem; justify-items: start; min-width: 0; }
  .hero h1 { font-size: clamp(2.5rem, 1.6rem + 3.8vw, 4.5rem); line-height: 1.04; letter-spacing: -0.028em; }
  .hero__accent { position: relative; display: block; width: fit-content; padding-bottom: 0.1em; color: var(--c-primary); }
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .hero__accent { background: linear-gradient(100deg, var(--c-primary) 15%, var(--c-secondary) 95%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  }
  @media (forced-colors: active) { .hero__accent { color: CanvasText; background: none; } }
  .hero__swoosh { position: absolute; left: 0; bottom: -0.06em; width: 100%; height: 0.24em; overflow: visible; }
  .hero__swoosh path { fill: none; stroke: #5bb8b2; stroke-width: 5; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; opacity: 0.85; }
  .hero__lead { max-width: 34rem; }
  .hero .btn-row { width: 100%; margin-top: 0.35rem; }
  /* Phones: each button takes the full row; from ~470 px they sit side by side. */
  .hero .btn-row > .btn { flex: 1 1 13rem; }
  .hero__cta { box-shadow: 0 10px 24px -10px rgb(11 95 165 / 0.6); }
  .hero__cta :global(svg) { transition: transform var(--dur) var(--ease); }
  .hero__cta:hover :global(svg) { transform: translateX(3px); }
  .hero__call { display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.9rem; margin-top: -0.25rem; color: var(--c-muted); font-weight: 600; }
  /* Shown only where the line never wraps, so it cannot dangle at a line end. */
  .hero__sep { display: none; width: 1px; height: 1.1rem; background: var(--c-line); }
  .hero__call a { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.75rem; color: var(--c-ink); font-weight: 700; text-decoration: none; font-variant-numeric: tabular-nums; }
  .hero__call a :global(svg) { color: var(--c-primary); }
  .hero__call a:hover { color: var(--c-primary); text-decoration: underline; }

  /* ---------- Visual ---------- */
  .hero__visual { position: relative; width: 100%; max-width: 40rem; justify-self: center; margin-bottom: 1.5rem; }
  /* Tilted, tinted plate behind the photo (echoes the "We are hiring" card). Inset keeps its rotated corners on screen. */
  .hero__visual::before {
    content: ''; position: absolute; inset: 0.4rem; border-radius: 1.75rem;
    background: linear-gradient(135deg, var(--c-secondary), var(--c-primary));
    opacity: 0.18; transform: rotate(2.5deg); transition: transform 600ms var(--ease);
  }
  /* The hairline ring keeps the photo's white wall from melting into the page. */
  .hero__frame { position: relative; border-radius: 1.5rem; overflow: hidden; box-shadow: 0 0 0 1px rgb(16 42 67 / 0.08), 0 28px 56px -26px rgb(16 42 67 / 0.45), var(--shadow-md); }
  .hero__frame :global(.media) { border-radius: inherit; }
  .hero__frame :global(img) { filter: saturate(0.9) contrast(0.97) brightness(1.02); transition: transform 1000ms var(--ease); }
  /* A soft shade along the bottom edge grounds the floating card. */
  .hero__frame::after { content: ''; position: absolute; inset: auto 0 0; height: 35%; background: linear-gradient(to top, rgb(16 42 67 / 0.16), transparent); pointer-events: none; }

  .hero__chip, .hero__card { position: absolute; z-index: 1; margin: 0; background: rgb(255 255 255 / 0.94); box-shadow: var(--shadow-lg); }
  @supports (backdrop-filter: blur(1px)) {
    .hero__chip, .hero__card { background: rgb(255 255 255 / 0.82); -webkit-backdrop-filter: blur(10px) saturate(1.4); backdrop-filter: blur(10px) saturate(1.4); }
  }
  /* The chip sits over the plain wall at the top right; on narrow phones that strip is too small, so it is hidden. */
  .hero__chip { display: none; top: -1rem; right: 1rem; align-items: center; gap: 0.45rem; padding: 0.55rem 1rem; border-radius: 999px; color: var(--c-ink); font-weight: 650; font-size: var(--fs-300); }
  .hero__chip :global(svg) { color: var(--c-accent); }
  .hero__card { left: 0.75rem; bottom: -1.5rem; max-width: calc(100% - 1.5rem); display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 1.1rem 0.7rem 0.75rem; border-radius: var(--radius-md); line-height: 1.3; }
  .hero__stack { display: flex; flex: none; }
  .hero__stack > span { display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 50%; background: var(--tone-soft); color: var(--tone); box-shadow: 0 0 0 2px #fff; }
  .hero__stack > span + span { margin-left: -0.55rem; }
  .hero__card-text { display: grid; min-width: 0; }
  .hero__card-text strong { color: var(--c-ink); font-size: 0.9375rem; }
  .hero__card-text span { color: var(--c-muted); font-size: 0.8125rem; }

  @media (max-width: 359.98px) {
    .hero .eyebrow { letter-spacing: 0.05em; }
    .hero .eyebrow::before { display: none; }
    .hero__stack > span:nth-child(n + 3) { display: none; }
  }
  @media (min-width: 420px) { .hero__sep { display: block; } .hero__call { gap: 0 0.65rem; } }
  @media (min-width: 600px) {
    .hero__chip { display: inline-flex; }
    .hero .btn-row { width: auto; }
    .hero .btn-row > .btn { flex: 0 0 auto; }
    /* Tablet, single column: a wider frame shows nearly the whole photo. */
    .hero__frame :global(.media) { aspect-ratio: 16 / 10 !important; }
  }
  @media (min-width: 960px) {
    .hero__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.04fr); }
    .hero__visual { max-width: none; margin-block: 1rem 1.5rem; }
    .hero__visual::before { inset: 0; transform: rotate(3deg); }
    .hero__frame { border-radius: 1.75rem; }
    .hero__frame :global(.media) { aspect-ratio: 4 / 3 !important; }
    .hero__chip { right: -0.75rem; }
    .hero__card { left: -2rem; }
  }

  /* ---------- Motion: once on load, nothing for reduced-motion users ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .hero__in { animation: hero-rise 700ms var(--ease) backwards; animation-delay: calc(var(--i, 0) * 80ms + 60ms); }
    .hero__swoosh path { animation: hero-draw 900ms var(--ease) 600ms backwards; }
    .hero__frame { animation: hero-unveil 1100ms cubic-bezier(0.2, 0.7, 0.2, 1) backwards; }
    .hero__frame :global(img) { animation: hero-zoom 1600ms var(--ease) backwards; }
    .hero__visual::before { animation: hero-plate 1100ms var(--ease) 150ms backwards; }
    .hero__chip { animation: hero-pop 600ms var(--ease) 700ms backwards; }
    .hero__card { animation: hero-pop 600ms var(--ease) 850ms backwards; }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hero__visual:hover .hero__frame :global(img) { transform: scale(1.035); }
    .hero__visual:hover::before { transform: rotate(4.5deg); }
  }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(18px); } }
  @keyframes hero-draw { from { stroke-dashoffset: 1; } }
  @keyframes hero-unveil { from { clip-path: inset(5% 5% 5% 5% round 2.5rem); } to { clip-path: inset(0 round 1.75rem); } }
  @keyframes hero-zoom { from { transform: scale(1.08); } }
  @keyframes hero-plate { from { opacity: 0; transform: rotate(0deg); } }
  @keyframes hero-pop { from { opacity: 0; transform: translateY(12px) scale(0.96); } }
</style>
