---
/** "How it works": the typical journey from first contact to care (content: `process` in content/pages.ts). */
import SectionHead from '../ui/SectionHead.astro';
import { process } from '../../content/pages';
interface Props { soft?: boolean }
const { soft = false } = Astro.props;
---
<section class:list={['section', soft && 'section--soft']} aria-labelledby="process-h">
  <div class="container">
    <SectionHead center id="process-h" eyebrow={process.eyebrow} title={process.title} text={process.intro} />
    <ol role="list" class="proc">
      {process.steps.map((s, i) => (
        <li class="proc__step reveal" style={`--reveal-delay:${i * 90}ms`}>
          <span class="proc__num" aria-hidden="true">{i + 1}</span>
          <h3><span class="sr-only">Step {i + 1}: </span>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .proc { display: grid; gap: 1.5rem; list-style: none; padding: 0; margin: 0; }
  .proc__step { position: relative; display: grid; align-content: start; gap: 0.5rem; padding: 1.5rem 1.5rem 1.75rem; background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-lg); }
  .proc__num { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--c-primary); color: #fff; font-weight: 700; font-family: var(--font-display); font-size: 1.15rem; margin-bottom: 0.4rem; }
  .proc__step h3 { font-size: 1.1875rem; }
  .proc__step p { color: var(--c-muted); }
  @media (min-width: 640px) { .proc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) {
    .proc { grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
    .proc__step:not(:last-child)::after { content: ''; position: absolute; top: 2.9rem; left: calc(100% - 0.2rem); width: 1.65rem; height: 2px; background: var(--c-primary-tint); }
  }
</style>
