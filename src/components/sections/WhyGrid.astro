---
import Media from '../ui/Media.astro';
import Icon from '../ui/Icon.astro';
import { whyAayush } from '../../content/pages';
interface Props { withImages?: boolean }
const { withImages = false } = Astro.props;
---
<ul role="list" class:list={['why', withImages && 'why--img']}>
  {whyAayush.map((w, i) => (
    <li class="why__card reveal" style={`--reveal-delay:${i * 90}ms`}>
      {withImages && <Media image={w.image} />}
      <div class="why__body">
        <span class="why__icon"><Icon name={w.icon} size={26} /></span>
        <h3>{w.title}</h3>
        <p>{w.text}</p>
      </div>
    </li>
  ))}
</ul>

<style>
  .why { display: grid; gap: 1.5rem; list-style: none; padding: 0; margin: 0; }
  @media (min-width: 760px) { .why { grid-template-columns: repeat(3, 1fr); } }
  .why__card { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm); }
  .why__card :global(.media) { border-radius: 0; }
  .why__body { display: grid; gap: 0.75rem; padding: 1.75rem 1.5rem 2rem; align-content: start; }
  .why__icon { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 50%; background: var(--c-secondary-soft); color: var(--c-secondary); }
  .why h3 { font-size: 1.1875rem; line-height: 1.3; }
  .why p { color: var(--c-muted); }
</style>
