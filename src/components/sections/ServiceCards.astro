---
import Media from '../ui/Media.astro';
import Icon from '../ui/Icon.astro';
import { services } from '../../content/services';
const single = services.length === 1;
---
<ul role="list" class:list={['svc-grid', single && 'svc-grid--single']}>
  {services.map((s, i) => (
    <li class="svc reveal" style={`--reveal-delay:${i * 90}ms`}>
      <Media image={s.image} />
      <div class="svc__body">
        <span class="svc__icon"><Icon name={s.icon} size={24} /></span>
        <h3><a href={`/services/${s.slug}`} class="svc__link">{s.title}</a></h3>
        <p>{s.summary}</p>
        {single && (
          <ul role="list" class="svc__points">
            {s.highlights.map((h) => <li><Icon name="check" size={16} /><span>{h}</span></li>)}
          </ul>
        )}
        <span class="link-arrow" aria-hidden="true">Learn more <Icon name="arrow-right" size={18} /></span>
      </div>
    </li>
  ))}
</ul>

<style>
  .svc-grid { display: grid; gap: 1.75rem; list-style: none; padding: 0; margin: 0; }
  @media (min-width: 760px) { .svc-grid:not(.svc-grid--single) { grid-template-columns: repeat(2, 1fr); } }
  /* Single service: one wide card, image beside the content */
  @media (min-width: 860px) {
    .svc-grid--single .svc { flex-direction: row; align-items: stretch; }
    .svc-grid--single .svc :global(.media) { flex: 0 0 46%; height: auto; aspect-ratio: auto !important; min-height: 22rem; }
    .svc-grid--single .svc__body { padding: 2.5rem; justify-content: center; }
    .svc-grid--single .svc__icon { margin-top: 0; outline: 0; }
  }
  .svc__points { list-style: none; margin: 0.25rem 0 0.5rem; padding: 0; display: grid; gap: 0.6rem; }
  .svc__points li { display: flex; gap: 0.65rem; align-items: flex-start; color: var(--c-text); font-size: 0.9375rem; }
  .svc__points :global(svg) { flex: none; margin-top: 0.2rem; color: var(--c-secondary); }
  .svc { position: relative; display: flex; flex-direction: column; background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm); transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  .svc:hover, .svc:focus-within { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: var(--c-primary-tint); }
  .svc :global(.media) { border-radius: 0; }
  .svc__body { display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem; padding: 1.5rem 1.5rem 1.75rem; flex: 1; }
  .svc__icon { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: var(--radius-md); background: var(--c-primary-soft); color: var(--c-primary); margin-top: -2.9rem; position: relative; box-shadow: var(--shadow-sm); outline: 4px solid #fff; }
  .svc h3 { margin-top: 0.25rem; }
  .svc__link { color: var(--c-ink); text-decoration: none; }
  .svc__link::after { content: ''; position: absolute; inset: 0; } /* whole card is the click target */
  .svc p { color: var(--c-muted); }
  .svc .link-arrow { color: var(--c-primary); margin-top: auto; padding-top: 0.25rem; }
  .svc:hover .link-arrow svg { transform: translateX(4px); }
</style>
