---
/**
 * A grid of post cards. By default the newest published posts; pass `posts` to show a specific list
 * (e.g. related articles). `lead` puts the featured (or newest) post first as a full-width card.
 * Each item carries `data-topic` for the /blog topic filter.
 */
import { getPublishedPosts, leadFirst, type Post } from '../../content/blog';
import PostCard from '../ui/PostCard.astro';

interface Props { limit?: number; posts?: Post[]; lead?: boolean }
const { limit, posts: given, lead = false } = Astro.props;
let posts = given ?? (await getPublishedPosts());
if (lead) posts = leadFirst(posts);
if (limit) posts = posts.slice(0, limit);
---
{posts.length === 0 ? (
  <p class="empty">No posts have been published yet. Please check back soon.</p>
) : (
  <ul role="list" class="posts" data-posts>
    {posts.map((p, i) => (
      <li class="posts__item reveal" data-topic={p.data.category} style={`--reveal-delay:${Math.min(i, 3) * 90}ms`}>
        <PostCard post={p} lead={lead && i === 0} />
      </li>
    ))}
  </ul>
)}

<style>
  /* auto-fit: two posts share the row, three or more fill up to three columns. */
  .posts { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); }
  .posts__item:has(:global(.post--lead)) { grid-column: 1 / -1; }
  .empty { padding: 2rem; text-align: center; background: var(--c-bg-soft); border-radius: var(--radius-md); color: var(--c-muted); }
</style>
