---
/** Home page "A Message from Our Founder": the founder's note beside his portrait, linking to /about. */
import Media from '../ui/Media.astro';
import Icon from '../ui/Icon.astro';
import QuoteBlock from '../ui/QuoteBlock.astro';
import { about } from '../../content/pages';
import { site } from '../../config/site';

const f = about.founder;
---
<section class="section fm-section" aria-labelledby="founder-msg-h">
  <div class="container fm">
    <div class="fm__visual reveal">
      <div class="fm__photo">
        <Media image={f.image} sizes="(min-width: 1200px) 440px, (min-width: 900px) 38vw, (min-width: 520px) 26rem, 88vw" />
      </div>
      <p class="fm__since"><Icon name="heart" size={16} /> Caring since {site.foundedLabel}</p>
      <div class="fm__badge">
        <span class="fm__badge-icon"><Icon name="award" size={22} /></span>
        <p><strong>{f.badge}</strong><span>{f.name}</span></p>
      </div>
    </div>

    <div class="fm__copy reveal" style="--reveal-delay:120ms">
      <p class="eyebrow">Why Aayush exists</p>
      <h2 id="founder-msg-h">A Message from Our Founder</h2>
      <QuoteBlock variant="pull" quote={{ text: f.quote, author: f.name }} showAuthor={false} />
      <div class="fm__letter">
        {f.message.map((p) => <p>{p}</p>)}
      </div>
      <div class="fm__sign">
        <p class="fm__signature">{f.name}</p>
        <p class="fm__role">{f.role} <span aria-hidden="true">·</span> {f.badge}</p>
      </div>
      <a class="btn btn--primary" href="/about">Read our full story <Icon name="arrow-right" size={18} /></a>
    </div>
  </div>
</section>

<style>
  .fm-section { position: relative; overflow: hidden; background: radial-gradient(42rem 28rem at 100% 0%, var(--c-bg-warm), transparent 70%), radial-gradient(36rem 26rem at 0% 100%, var(--c-primary-soft), transparent 70%), #fff; }
  .fm { display: grid; gap: clamp(3rem, 2rem + 3vw, 4.5rem); align-items: center; }

  /* Founder portrait with a soft offset frame, a "since" chip and the Indian Navy badge overlapping the corner. */
  .fm__visual { position: relative; width: min(100%, 26rem); margin-inline: auto; padding: 0 0 2.75rem 0; }
  .fm__photo { position: relative; }
  .fm__photo::before { content: ''; position: absolute; inset: 0.75rem -0.5rem -0.5rem 0.75rem; border-radius: calc(var(--radius-lg) + 0.5rem); background: linear-gradient(140deg, var(--c-secondary-soft), var(--c-primary-tint)); z-index: 0; }
  .fm__photo :global(.media) { position: relative; z-index: 1; border-radius: calc(var(--radius-lg) + 0.5rem); box-shadow: var(--shadow-lg); }
  .fm__since { position: absolute; z-index: 2; top: 1rem; left: 1rem; display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.85rem; border-radius: 999px; background: rgb(255 255 255 / 0.94); color: var(--c-ink); font-size: var(--fs-300); font-weight: 650; box-shadow: var(--shadow-md); }
  .fm__since :global(svg) { color: var(--c-accent); }
  .fm__badge { position: absolute; z-index: 2; left: 0.75rem; right: 0.75rem; bottom: 0; display: flex; align-items: center; gap: 0.85rem; max-width: 20rem; padding: 0.65rem 1.25rem 0.65rem 0.65rem; border-radius: 999px; background: var(--c-navy); color: #fff; box-shadow: var(--shadow-lg); }
  .fm__badge-icon { flex: none; display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: #fff; color: var(--c-navy); }
  .fm__badge p { display: grid; line-height: 1.3; min-width: 0; }
  .fm__badge strong { font-size: var(--fs-400); white-space: nowrap; }
  .fm__badge p span { color: #c9d6e3; font-size: var(--fs-300); }

  .fm__copy { display: grid; gap: 1.25rem; justify-items: start; max-width: 40rem; }
  .fm__letter { display: grid; gap: 1rem; }
  .fm__sign { display: grid; gap: 0.15rem; padding-top: 0.25rem; }
  .fm__signature { font-family: var(--font-display); font-style: italic; font-weight: 500; font-size: 1.6rem; line-height: 1.2; color: var(--c-primary-strong); }
  .fm__role { color: var(--c-muted); font-size: var(--fs-400); font-weight: 600; }
  .fm__copy .btn { margin-top: 0.5rem; }

  @media (min-width: 900px) {
    .fm { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 5rem; }
    .fm__visual { width: 100%; padding-bottom: 0; }
    .fm__photo::before { inset: 1.1rem -0.9rem -0.9rem 1.1rem; }
    .fm__badge { left: -1.5rem; right: auto; bottom: -1.75rem; }
    .fm__badge strong { font-size: var(--fs-500); }
  }
</style>
