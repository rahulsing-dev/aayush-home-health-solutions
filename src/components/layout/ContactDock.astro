---
/**
 * Always-available contact actions.
 *  - Below 1100px (phones/tablets): a bar fixed to the bottom of the screen with
 *    Call · WhatsApp · Enquire, so contacting us is one tap from anywhere on the page.
 *  - 1100px and up: a single floating WhatsApp button (the header already shows phone + enquiry).
 * The bar hides while a form field has focus, so it never sits on top of the on-screen keyboard.
 * `data-contact` attributes mark each action for click analytics later (roadmap Phase 8).
 */
import Icon from '../ui/Icon.astro';
import { contact, telHref, whatsappHref } from '../../config/site';
import { headerCta } from '../../config/navigation';
import { cleanPath } from '../../lib/paths';

const phone = contact.phones[0];
// On the contact page the form is already in view, so "Enquire" would be redundant.
const showEnquire = cleanPath(Astro.url.pathname) !== headerCta.href;
const wa = whatsappHref();
---
<aside class="contact-shortcuts" aria-label="Contact shortcuts">
<div class:list={['dock', !showEnquire && 'dock--two']}>
  <a class="dock__btn dock__btn--call" href={telHref(phone.tel)} data-contact="call">
    <Icon name="phone" size={22} /><span>Call<span class="sr-only"> {phone.display}</span></span>
  </a>
  <a class="dock__btn dock__btn--wa" href={wa} target="_blank" rel="noopener noreferrer" data-contact="whatsapp">
    <Icon name="whatsapp" size={22} /><span>WhatsApp<span class="sr-only"> (opens WhatsApp)</span></span>
  </a>
  {showEnquire && (
    <a class="dock__btn dock__btn--enq" href={headerCta.href} data-contact="enquire">
      <Icon name="mail" size={22} /><span>Enquire</span>
    </a>
  )}
</div>

<a class="wa-fab" href={wa} target="_blank" rel="noopener noreferrer" data-contact="whatsapp" aria-label={`Chat with us on WhatsApp, ${contact.whatsapp.display} (opens WhatsApp)`}>
  <Icon name="whatsapp" size={30} />
  <span class="wa-fab__tip" aria-hidden="true">Chat on WhatsApp</span>
</a>
</aside>

<style>
  /* ---------- Mobile / tablet bar ---------- */
  .dock {
    position: fixed; z-index: 90; left: 0; right: 0; bottom: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem;
    padding: 0.5rem var(--gutter) calc(0.5rem + env(safe-area-inset-bottom));
    background: rgb(255 255 255 / 0.97); border-top: 1px solid var(--c-line); box-shadow: 0 -6px 20px rgb(16 42 67 / 0.08);
    transition: transform var(--dur) var(--ease);
  }
  .dock--two { grid-template-columns: repeat(2, 1fr); }
  .dock__btn {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.15rem;
    min-height: 3.25rem; border-radius: var(--radius-sm); border: 2px solid transparent;
    font-size: 0.8125rem; font-weight: 700; line-height: 1.1; text-decoration: none;
  }
  .dock__btn:active { transform: translateY(1px); }
  .dock__btn--call { background: var(--c-primary); color: #fff; }
  .dock__btn--wa { background: var(--c-whatsapp); color: #fff; }
  .dock__btn--enq { background: #fff; color: var(--c-primary); border-color: var(--c-primary); }
  .dock__btn--call:hover, .dock__btn--wa:hover { color: #fff; filter: brightness(0.92); }
  .dock__btn--enq:hover { background: var(--c-primary-soft); color: var(--c-primary-strong); }
  /* Keep page content (footer links) clear of the bar. */
  :global(body) { padding-bottom: calc(4.25rem + env(safe-area-inset-bottom)); }
  /* Hide while typing, so the bar never covers inputs above the on-screen keyboard. */
  :global(html.is-typing) .dock { transform: translateY(110%); }

  /* ---------- Desktop floating WhatsApp button ---------- */
  .wa-fab {
    position: fixed; z-index: 90; right: 1.5rem; bottom: 1.5rem;
    display: none; place-items: center; width: 3.75rem; height: 3.75rem; border-radius: 50%;
    background: var(--c-whatsapp); color: #fff; box-shadow: var(--shadow-lg);
    transition: transform var(--dur) var(--ease), filter var(--dur) var(--ease);
  }
  .wa-fab:hover, .wa-fab:focus-visible { color: #fff; transform: translateY(-2px); filter: brightness(0.92); }
  .wa-fab__tip {
    position: absolute; right: calc(100% + 0.75rem); top: 50%; transform: translateY(-50%);
    padding: 0.45rem 0.8rem; border-radius: var(--radius-sm); background: var(--c-navy); color: #fff;
    font-size: 0.875rem; font-weight: 600; white-space: nowrap; opacity: 0; pointer-events: none;
    transition: opacity var(--dur) var(--ease);
  }
  .wa-fab:hover .wa-fab__tip, .wa-fab:focus-visible .wa-fab__tip { opacity: 1; }

  @media (min-width: 1100px) {
    .dock { display: none; }
    :global(body) { padding-bottom: 0; }
    .wa-fab { display: grid; }
  }
  @media print { .dock, .wa-fab { display: none !important; } :global(body) { padding-bottom: 0; } }
</style>

<script>
  // Flag "typing" while a text field has focus so the bottom bar can step aside for the keyboard.
  const isField = (el: EventTarget | null) => el instanceof HTMLElement && el.matches('input:not([type="checkbox"]):not([type="radio"]), select, textarea');
  document.addEventListener('focusin', (e) => { if (isField(e.target)) document.documentElement.classList.add('is-typing'); });
  document.addEventListener('focusout', (e) => { if (isField(e.target)) document.documentElement.classList.remove('is-typing'); });
</script>
