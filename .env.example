# Copy to `.env` for local development. Never commit real values (`.env` is git-ignored).

# Canonical public URL of the deployed site (used for canonical links, sitemap.xml, robots.txt).
SITE_URL=https://www.aayushhomehealth.com

# --- Contact / booking form delivery (Web3Forms) -------------------------------------
# Web3Forms access key (https://web3forms.com, registered to the business Gmail address).
# Setting ONLY this takes the form live; submissions are emailed to that address.
# Leave it empty to run the form in DEMO MODE: it validates, then says clearly that nothing was sent.
# NOTE: PUBLIC_* variables are embedded in the browser bundle by design (a Web3Forms key is
# meant to be used from the browser). Never put secrets here.
# On Cloudflare Pages: Workers & Pages -> (project) -> Settings -> Variables and Secrets,
# add PUBLIC_WEB3FORMS_ACCESS_KEY for Production (and Preview), then redeploy
# (values are baked in at build time).
PUBLIC_WEB3FORMS_ACCESS_KEY=
# Optional: send to a different endpoint (Formspree, your own API). Defaults to Web3Forms when a key is set.
PUBLIC_FORM_ENDPOINT=
