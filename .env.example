# Copy to `.env` for local development. Never commit real values.

# Canonical public URL of the deployed site (used for canonical links, sitemap.xml, robots.txt).
SITE_URL=https://www.aayushhomehealth.com

# --- Contact / enquiry form delivery -------------------------------------------------
# Leave PUBLIC_FORM_ENDPOINT empty to run the forms in DEMO MODE: they validate and show
# a success state that clearly says nothing was sent.
# Set it to a form-backend endpoint (Formspree, Web3Forms, Getform, or your own API).
# NOTE: PUBLIC_* variables are embedded in the browser bundle by design. Only use
# endpoint URLs / public access keys that are meant to be public. Never put secrets here.
PUBLIC_FORM_ENDPOINT=
# Optional: public access key, sent as `access_key` in the JSON body (Web3Forms style).
PUBLIC_FORM_ACCESS_KEY=

# Show small "Placeholder / confirm" badges beside unverified content (true | false).
# Set to false once the owner has confirmed or replaced all draft content.
PUBLIC_SHOW_DRAFT_FLAGS=true
